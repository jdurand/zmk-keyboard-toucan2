// Toucan layout for config and shield builds.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 2400

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NUM   1
#define SYM   2
#define AERO  3
// Layer 4 is also activated by the trackpad's is_touching_processor.
#define MOUSE 4
#define NAV   5
#define ACC   6
#define ACCS  7
#define EXTRA 8
#define SYS   9

// Sequential taps release modifiers between the dead key/prefix and next key.
#define MACRO_BINDING_CELLS #binding-cells
#define TAP_SEQUENCE(macro_name, ...) \
    macro_name: macro_name { \
        compatible = "zmk,behavior-macro"; \
        display-name = #macro_name; \
        MACRO_BINDING_CELLS = <0>; \
        bindings = <__VA_ARGS__>; \
    };

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&msc {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // Hold the two inner thumbs to access extra shortcuts.
        extra_thumbs {
            timeout-ms = <50>;
            key-positions = <38 39>;
            bindings = <&mo EXTRA>;
            layers = <BASE>;
        };

        // A+S and L+semicolon uppercase-accent chords.
        accs_left {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&mo ACCS>;
            require-prior-idle-ms = <250>;
            layers = <BASE>;
        };

        accs_right {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&mo ACCS>;
            require-prior-idle-ms = <250>;
            layers = <BASE>;
        };
    };

    macros {
        // Hold Command and the window-management layer together.
        aero_gui: aero_gui {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LGUI &mo AERO>,
                <&macro_pause_for_release>,
                <&macro_release &mo AERO &kp LGUI>;
        };

        TAP_SEQUENCE(tmux_a, &kp LC(A) &kp A)
        TAP_SEQUENCE(tmux_s, &kp LC(A) &kp S)
        TAP_SEQUENCE(tmux_d, &kp LC(A) &kp D)
        TAP_SEQUENCE(tmux_f, &kp LC(A) &kp F)
        TAP_SEQUENCE(tmux_g, &kp LC(A) &kp G)
        TAP_SEQUENCE(tmux_space, &kp LC(A) &kp SPACE)
        TAP_SEQUENCE(tmux_z, &kp LC(A) &kp Z)

        // macOS Option/dead-key sequences, shared by SYM and accent layers.
        TAP_SEQUENCE(ac_e, &kp LA(E) &kp E)
        TAP_SEQUENCE(gr_e, &kp LA(GRAVE) &kp E)
        TAP_SEQUENCE(gr_a, &kp LA(GRAVE) &kp A)
        TAP_SEQUENCE(gr_u, &kp LA(GRAVE) &kp U)
        TAP_SEQUENCE(cf_e, &kp LA(I) &kp E)
        TAP_SEQUENCE(cf_a, &kp LA(I) &kp A)
        TAP_SEQUENCE(cf_o, &kp LA(I) &kp O)
        TAP_SEQUENCE(cf_i, &kp LA(I) &kp I)
        TAP_SEQUENCE(cd_c, &kp LA(C))

        TAP_SEQUENCE(ac_e_u, &kp LA(E) &kp LS(E))
        TAP_SEQUENCE(gr_e_u, &kp LA(GRAVE) &kp LS(E))
        TAP_SEQUENCE(gr_a_u, &kp LA(GRAVE) &kp LS(A))
        TAP_SEQUENCE(gr_u_u, &kp LA(GRAVE) &kp LS(U))
        TAP_SEQUENCE(cf_e_u, &kp LA(I) &kp LS(E))
        TAP_SEQUENCE(cf_a_u, &kp LA(I) &kp LS(A))
        TAP_SEQUENCE(cf_o_u, &kp LA(I) &kp LS(O))
        TAP_SEQUENCE(cf_i_u, &kp LA(I) &kp LS(I))
        TAP_SEQUENCE(cd_c_u, &kp LS(LA(C)))
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB          &kp Q        &kp W     &kp E      &kp R     &kp T   &kp Y &kp U     &kp I      &kp O     &kp P          &kp BSPC
                &mt LCTRL ESC    &mt LSHFT A  &lt ACC S &mt LALT D &lt SYM F &kp G   &kp H &lt SYM J &mt LALT K &lt ACC L &mt RSHFT SEMI &kp SQT
                &mt LSHFT ENTER  &kp Z        &kp X     &kp C      &kp V     &kp B   &kp N &kp M     &kp COMMA  &kp DOT   &kp FSLH       &mt RSHFT ENTER
                                            &kp LGUI &aero_gui &lt NUM SPACE   &lt NAV BSPC &kp RGUI &kp RALT
            >;
        };

        number {
            display-name = "NUM";
            bindings = <
                &kp TILDE       &kp EXCL     &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR     &kp DEL
                &kp GRAVE       &mt LSHFT N1 &kp N2 &kp N3   &kp N4   &kp N5      &kp N6    &kp N7   &kp N8    &kp N9   &mt RSHFT N0 &trans
                &mt LSHFT ENTER &kp N6       &kp N7 &kp N8   &kp N9   &kp N0      &none     &none    &trans    &trans   &kp BSLH     &trans
                                            &trans &trans &trans   &lt MOUSE BSPC &trans &lt SYS RALT
            >;
        };

        symbol {
            display-name = "SYM";
            bindings = <
                &trans &gr_a   &gr_e   &ac_e   &cf_e   &tmux_space   &kp PLUS  &kp LBKT &kp RBKT &kp DQT   &kp PIPE  &kp DEL
                &trans &tmux_a &tmux_s &tmux_d &tmux_f &tmux_g       &kp MINUS &kp LPAR &kp RPAR &kp SQT   &kp EQUAL &kp TILDE
                &trans &tmux_z &none   &cd_c   &none   &none         &kp UNDER &kp LBRC &kp RBRC &kp GRAVE &kp BSLH  &none
                                            &trans &trans &trans   &trans &trans &trans
            >;
        };

        aerospace {
            display-name = "AERO";
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &trans &trans   &trans &trans &trans &trans &trans    &kp DEL
                &kp TAB   &trans &trans &kp E  &trans &trans   &trans &trans &trans &trans &kp RSHFT &trans
                &trans    &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans    &trans
                                      &trans &trans &mo MOUSE   &trans &trans &trans
            >;
        };

        mouse {
            display-name = "MOUSE";
            bindings = <
                &none  &trans &trans &mkp MCLK &trans    &trans   &trans         &trans         &trans       &trans          &trans &trans
                &trans &trans &trans &mkp RCLK &mkp LCLK &trans   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &trans &trans
                &trans &trans &trans &trans    &trans    &trans   &msc SCRL_LEFT &msc SCRL_UP   &msc SCRL_DOWN &msc SCRL_RIGHT &trans &trans
                                    &mkp MCLK &mkp LCLK &mkp RCLK   &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        movement {
            display-name = "MOVE";
            bindings = <
                &none  &kp F1    &kp F2 &kp F3  &kp F4  &kp F5      &kp F6   &kp F7    &kp F8    &kp F9    &kp F10   &kp DEL
                &trans &kp LSHFT &none  &kp F11 &kp F12 &none       &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &kp RSHFT &trans
                &trans &none     &none  &none   &none   &none       &kp HOME &kp PG_DN &kp PG_UP &kp END   &none     &trans
                                    &trans &trans &lt MOUSE SPACE   &trans &trans &trans
            >;
        };

        accent {
            display-name = "ACC";
            bindings = <
                &trans &trans &gr_e  &ac_e  &cf_e  &trans   &trans &gr_u  &cf_i  &cf_o  &trans &trans
                &trans &gr_a  &cf_a  &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &cd_c  &trans &trans   &trans &trans &trans &trans &trans &trans
                                    &trans &trans &trans   &trans &trans &trans
            >;
        };

        accent_shifted {
            display-name = "ACCS";
            bindings = <
                &trans &trans  &gr_e_u &ac_e_u &cf_e_u &trans   &trans &gr_u_u &cf_i_u &cf_o_u &trans &trans
                &trans &gr_a_u &cf_a_u &trans  &trans  &trans   &trans &trans  &trans  &trans  &trans &trans
                &trans &trans  &trans  &cd_c_u &trans  &trans   &trans &trans  &trans  &trans  &trans &trans
                                      &trans &trans &trans   &trans &trans &trans
            >;
        };

        extra {
            display-name = "EXTRA";
            bindings = <
                &trans &trans &trans &trans &kp C_VOL_UP &kp LC(GRAVE)   &none &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &kp C_VOL_DN &kp LC(G)       &kp LC(LA(LG(SPACE))) &kp C_MUTE &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans          &trans &trans &trans &trans &trans &trans
                            &trans &trans &trans   &trans &trans &mo SYS
            >;
        };

        system {
            display-name = "SYS";
            bindings = <
                &none       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &none &none      &none      &none &none &bt BT_CLR
                &none       &none        &none        &none        &none        &none          &none &bt BT_NXT &bt BT_PRV &none &none &none
                &bootloader &studio_unlock &none      &none        &none        &none          &none &none      &none      &none &none &bootloader
                                                    &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};
